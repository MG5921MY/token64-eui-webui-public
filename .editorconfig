# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8

# Markdown files
[*.md]
charset = utf-8
trim_trailing_whitespace = false

# YAML files
[*.{yml,yaml}]
charset = utf-8
indent_style = space
indent_size = 2

# Rust files
[*.rs]
charset = utf-8
indent_style = space
indent_size = 4

# TOML files
[*.toml]
charset = utf-8
indent_style = space
indent_size = 2

# JavaScript/TypeScript
[*.{js,ts,jsx,tsx}]
charset = utf-8
indent_style = space
indent_size = 2

# HTML
[*.html]
charset = utf-8
indent_style = space
indent_size = 2

# CSS
[*.css]
charset = utf-8
indent_style = space
indent_size = 2
